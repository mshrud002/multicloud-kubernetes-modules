cluster_name = "my-aks-cluster"
location     = "eastus"

# === Mode 1: AKS Automatic (uncomment to use) ===
# enable_automatic_mode         = true
# enable_node_auto_provisioning = false
# node_pools                    = {}

# === Mode 2: Node Auto Provisioning (uncomment to use) ===
enable_automatic_mode         = false
enable_node_auto_provisioning = true
node_pools                    = {}

# === Mode 3: Traditional Node Pools (uncomment to use) ===
# enable_automatic_mode         = false
# enable_node_auto_provisioning = false
# node_pools = {
#   system = {
#     vm_size       = "Standard_DS2_v2"
#     desired_count = 2
#     min_count     = 1
#     max_count     = 5
#     labels = {
#       "pool" = "system"
#     }
#   }
#   user = {
#     vm_size       = "Standard_D2s_v3"
#     desired_count = 3
#     min_count     = 2
#     max_count     = 10
#   }
# }

# Karpenter (experimental on AKS)
enable_karpenter = false
# karpenter_config = {
#   chart_version      = "1.2.0"
#   identity_client_id = "00000000-0000-0000-0000-000000000000"
# }

tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
}

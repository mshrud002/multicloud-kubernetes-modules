project_id      = "my-gcp-project"
cluster_name    = "my-gke-cluster"
region          = "us-central1"
kubernetes_version = "1.31"

# GKE Autopilot (Google-managed nodes and infrastructure)
enable_autopilot = true

# If using standard mode instead:
# enable_autopilot = false
# node_pools = {
#   default-pool = {
#     machine_type       = "e2-standard-4"
#     initial_node_count = 2
#     min_count          = 1
#     max_count          = 10
#     disk_size_gb       = 100
#   }
#   gpu-pool = {
#     machine_type       = "g2-standard-4"
#     initial_node_count = 0
#     min_count          = 0
#     max_count          = 5
#   }
# }

network    = "default"
subnetwork = "default"
release_channel = "REGULAR"

# Karpenter (experimental on GKE)
enable_karpenter = false
# karpenter_config = {
#   chart_version = "1.2.0"
# }

tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
}
